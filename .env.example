# Environment Configuration for ADK Models
# Copy this file to .env and replace the placeholder values

# =============================================================================
# AUTHENTICATION METHOD 1: Google Cloud Vertex AI (Recommended for Production)
# =============================================================================
# Use this method if you want to use Vertex AI with Application Default Credentials
# Requires: gcloud auth application-default login

GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# =============================================================================
# AUTHENTICATION METHOD 2: Google AI Studio (API Key)
# =============================================================================
# Use this method for quick setup and testing
# Get your API key from: https://aistudio.google.com/apikey
# Uncomment the lines below and comment out the Vertex AI settings above

# GOOGLE_API_KEY=your-api-key-here
# GOOGLE_GENAI_USE_VERTEXAI=FALSE

# =============================================================================
# OPTIONAL: Additional Configuration
# =============================================================================

# Uncomment to enable debug logging
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Set quota project (if different from main project)
# GOOGLE_CLOUD_QUOTA_PROJECT=your-quota-project-id
